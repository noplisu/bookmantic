# OpenAI — required for embeddings and search
OPENAI_API_KEY=

# PostgreSQL (defaults match compose.yaml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis / Sidekiq
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins; default *). For the Next.js app in ../frontend/ use:
# CORS_ORIGINS=http://localhost:3001

# Amazon Associates (optional — omit until approved; enables purchase_url in API)
# AMAZON_ASSOCIATE_TAG=
# AMAZON_MARKETPLACE_HOST=www.amazon.com

# Rate limits (production only; optional overrides)
# RACK_ATTACK_SEARCH_LIMIT=30
# RACK_ATTACK_SEARCH_PERIOD=300
# RACK_ATTACK_SIMILAR_LIMIT=60
# RACK_ATTACK_SIMILAR_PERIOD=300

# Seed CSV: default picks db/books_top40k.csv if present, else db/book_details.csv
# BOOK_SEED_PATH=db/my_export.csv
# BOOK_SEED_LIMIT=500
# BOOK_SEED_FULL=1
# BOOK_SEED_BATCH_SIZE=500
