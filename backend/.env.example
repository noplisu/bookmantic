# OpenAI — required for embeddings and search
OPENAI_API_KEY=

# PostgreSQL (defaults match compose.yaml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis / Sidekiq
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins; default *). For the Next.js app in ../frontend/ use:
# CORS_ORIGINS=http://localhost:3001

# Seed CSV: default picks db/books_top40k.csv if present, else db/book_details.csv
# BOOK_SEED_PATH=db/my_export.csv
# BOOK_SEED_LIMIT=500
# BOOK_SEED_FULL=1
# BOOK_SEED_BATCH_SIZE=500
