#!/usr/bin/env bash
# Full database reset: drop, create, load db/structure.sql, seed.
# Uses Rails for all DB access so structure and seeds hit the same Postgres as the app.
# Requires `psql` on PATH (Rails db:schema:load invokes it with DATABASE_* from .env).
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v psql >/dev/null 2>&1; then
  echo "db-reset: 'psql' is required (install postgresql-client)." >&2
  echo "  Rails loads db/structure.sql via psql using the same host/port as config/database.yml." >&2
  echo "  Do not load structure only through 'docker compose exec' unless Rails uses that same instance." >&2
  exit 1
fi

wipe_public_schema() {
  local env="$1"
  RAILS_ENV="$env" bin/rails runner "
    conn = ActiveRecord::Base.connection
    conn.execute('DROP SCHEMA IF EXISTS public CASCADE')
    conn.execute('CREATE SCHEMA public')
    conn.execute('GRANT ALL ON SCHEMA public TO postgres')
    conn.execute('GRANT ALL ON SCHEMA public TO public')
  "
}

bin/rails db:drop db:create

for env in development test; do
  echo "Loading structure into ${env}…"
  wipe_public_schema "$env"
  RAILS_ENV="$env" bin/rails db:schema:load
done

bin/rails db:seed
