# Copy to deployment/.env on the VPS (never commit .env).

# --- Public site (Caddy / TLS) ---
DOMAIN=books.example.com
ACME_EMAIL=you@example.com

# --- GHCR images (GitHub owner must be lowercase; deploy workflow pushes :latest) ---
BACKEND_IMAGE=ghcr.io/your-github-username/semantic-search-rails-backend:latest
FRONTEND_IMAGE=ghcr.io/your-github-username/semantic-search-rails-frontend:latest

# --- Rails ---
RAILS_MASTER_KEY=
OPENAI_API_KEY=

# Optional: comma-separated origins if you call the API directly from the browser
# CORS_ORIGINS=https://books.example.com

# Amazon Associates (optional — purchase button appears when set)
# AMAZON_ASSOCIATE_TAG=
# AMAZON_MARKETPLACE_HOST=www.amazon.com

# Frontend (optional)
# NEXT_PUBLIC_SITE_URL=https://books.example.com

# --- Postgres (used by backend, sidekiq, and postgres service) ---
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-strong-password
DATABASE_NAME=semantic_search_rails_production
