# Optional: direct Rails URL (no trailing slash). Omit to use /api rewrites (recommended for production).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Canonical site URL for Open Graph (production)
# NEXT_PUBLIC_SITE_URL=https://bookmatic.com

# Show Indexed / similarity chips (default off)
# NEXT_PUBLIC_SHOW_DEBUG=false
