# OpenAI — required for embeddings and search
OPENAI_API_KEY=

# PostgreSQL (defaults match compose.yaml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis / Sidekiq
REDIS_URL=redis://localhost:6379/0

# CORS (optional, comma-separated list; default *)
# CORS_ORIGINS=https://example.com,http://localhost:5173
